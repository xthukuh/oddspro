#DEPLOY_WEB_DIR=/home2/oddsprok/public_html
#DEPLOY_DB_NAME=oddsprok_prod_<version_underscored>
DEPLOY_DB_USER=oddsprok_root
DEPLOY_DB_PASSWORD=
#DEPLOY_NODE_BIN=/home2/oddsprok/.nvm/versions/node/v24.18.0/bin
